{
  "expo": {
    "name": "metroapp",
    "slug": "metroapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoMetropolitano.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/LogoMetropolitano.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LogoMetropolitano_c.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.radiocat_fanzine.metroapp"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "9dae3c6d-a678-4ef0-831f-2922468fec3e"
      }
    }
  }
}
